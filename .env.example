# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored. The key is read only by the server and is never sent to the browser.

# --- Azure OpenAI (your deployment)
AZURE_OPENAI_API_KEY=your-azure-openai-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VERSION=2025-01-01-preview

# --- Alternative: standard OpenAI API (used only if the Azure values above are blank)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- AI cost and reliability controls (optional; defaults shown)
# Set to 1 to run fully offline with the built-in story text.
GP_DISABLE_AI=0
# Give up on any AI request after this many milliseconds and use the built-in text.
AI_TIMEOUT_MS=5000
# Hard cap on AI calls per calendar day across all players.
AI_DAILY_BUDGET=600
# Cap on AI calls per player per hour.
AI_USER_HOURLY_LIMIT=25

# --- Database
# Leave DATABASE_URL empty to keep everything on this computer (a built-in Postgres stored in
# ./data/pglite - works offline, nothing to install).
# To use Supabase (needed for hosting on Vercel): Supabase -> your project -> Connect ->
# "Transaction pooler" -> copy the URI and put your database password in it. Port is 6543.
# Never paste this URL into chats, screenshots or code - it is a password.
DATABASE_URL=
# Where the built-in database is stored when DATABASE_URL is empty.
DATABASE_PATH=./data/pglite

# --- Sessions: how long a login lasts, in hours.
SESSION_HOURS=12
